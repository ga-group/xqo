<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="owl2html.xslt.xml"?>
<rdf:RDF xmlns:dc="http://purl.org/dc/elements/1.1/"
   xmlns:dcat="http://www.w3.org/ns/dcat#"
   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:fibo-fnd-acc-cur="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/"
   xmlns:gufo="http://purl.org/nemo/gufo#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:pav="http://purl.org/pav/"
   xmlns:qudt="http://qudt.org/schema/qudt/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sh="http://www.w3.org/ns/shacl#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:swrl="http://www.w3.org/2003/11/swrl#"
   xmlns:tempo="http://purl.org/tempo/"
   xmlns:unit="http://qudt.org/vocab/unit/"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:xqo-ps="http://schema.ga-group.nl/xqo/ps/"
   xmlns:xqo="http://schema.ga-group.nl/xqo/"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <rdf:Description rdf:about="http://example.com/bbg/CLA_Comdty">
    <xqo-ps:contract-size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</xqo-ps:contract-size>
    <xqo-ps:contract-unit rdf:resource="http://qudt.org/vocab/unit/Barrel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/cme/CLZ6_Comdty">
    <xqo:ordinal rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2026-12</xqo:ordinal>
    <xqo-ps:specifiedBy rdf:resource="http://example.com/bbg/CLA_Comdty"/>
    <rdfs:label>CLZ6</rdfs:label>
  </rdf:Description>
  <owl:Ontology rdf:about="http://schema.ga-group.nl/xqo/ps/">
    <dc:abstract xml:lang="en">xqo-ps is an xqo module that captures product specs.</dc:abstract>
    <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sebastian Freundt</dc:creator>
    <dc:description xml:lang="en">Overview
--------
The exchange quirks ontology (xqo) product specs (ps) module provides
vocabulary to capture the instatiation templates of exchange-listed
derivatives.


Why?
----

Neither FIBO nor FIX deal with analytical workflows like, in this
case, universe selection.


How?
----



Where?
------

This ontology is part of [xqo](http://schema.ga-group.nl/xqo/),
([official github repository](https://github.com/ga-group/xqo/)).

The project's canonical home is &lt;http://schema.ga-group.nl/xqo/ps/&gt;.
</dc:description>
    <dct:creator rdf:resource="https://orcid.org/0000-0002-7352-2825"/>
    <dct:format rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text/turtle</dct:format>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-01T05:00:00Z</dct:issued>
    <dct:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dct:language>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-01T05:00:00Z</dct:modified>
    <dct:publisher rdf:resource="https://orcid.org/0000-0002-7352-2825"/>
    <dct:title>xqo-ps -- product specs</dct:title>
    <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xqo-ps</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://schema.ga-group.nl/xqo/ps/</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="en">xqo-ps</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://github.com/ga-group/xqo"/>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/"/>
    <owl:versionIRI rdf:resource="http://schema.ga-group.nl/xqo/0.1/ps/"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1</owl:versionInfo>
    <dcat:downloadURL rdf:resource="http://schema.ga-group.nl/xqo/ps/rdf"/>
    <dcat:downloadURL rdf:resource="http://schema.ga-group.nl/xqo/ps/ttl"/>
  </owl:Ontology>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ps/BackMonth">
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Role"/>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ps/ContractSpecs">
    <rdfs:comment xml:lang="en">Exchange-specific, instantiation-neutral description of a futures contract.</rdfs:comment>
    <rdfs:label>contract specs</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Description"/>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ps/FrontMonth">
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Role"/>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ps/Quarterly">
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Role"/>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ps/SerialMonth">
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Role"/>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ps/ShortDated">
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Role"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/ps/contract-months">
    <rdfs:comment xml:lang="en">Indicator of concurrently active contracts in truffle syntax.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">contract months</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/ps/contract-size">
    <rdfs:comment xml:lang="en">Physical or notional amount of the underlying that one contract controls.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">contract size</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/contract-unit"/>
    <skos:editorialNote xml:lang="en">Certain products stipulate different
contract sizes depending on the month, the quarter, the semester, or
the year in question.  For example if the contract were to specify a
fixed amount per hour (as is the case for electricity), the resulting
contract can be of size 672, 696, 719, 720, 721, 743, 744, 745, for
months of 28, 29, 30, or 31 days and possibly accounting for the
beginning or the end of daylight saving.</skos:editorialNote>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://schema.ga-group.nl/xqo/ps/contract-unit">
    <rdfs:comment xml:lang="en">Unit of the physical or notional amount of the underlying.</rdfs:comment>
    <rdfs:label xml:lang="en">contract unit</rdfs:label>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/contract-size"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://schema.ga-group.nl/xqo/ps/point-ccy">
    <rdfs:comment xml:lang="en">Currency in which the monetary value of a one-point move is expressed.</rdfs:comment>
    <rdfs:label xml:lang="en">point currency</rdfs:label>
    <rdfs:range rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/point-value"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/ps/point-value">
    <rdfs:comment xml:lang="en">Monetary value of a one-point move.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">point value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/point-ccy"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://schema.ga-group.nl/xqo/ps/quote-unit">
    <rdfs:comment xml:lang="en">Unit of quoting, deprecated.  Replaced by the 4-tuple of xqo-ps:contract-value, xqo-ps:contract-unit, xqo-ps:point-value, and xqo-ps:point-ccy.  Calculated as (xqo-ps:point-value / xqo-ps:contract-value) * (xqo-ps:point-ccy / xqo-ps:contract-unit).</rdfs:comment>
    <rdfs:label xml:lang="en">quote unit</rdfs:label>
    <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/contract-unit"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/point-value"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/ps/tick-size">
    <rdfs:comment xml:lang="en">Minimum price increment in points.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">tick size</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:editorialNote xml:lang="en">Some exchanges stipulate different
tick sizes depending on whether the contract is, say, the front month
(as opposed to back month and later), or e.g. a serial month (as
opposed to a weekly or quarterly).  xqo provides supporting classes
(anti-rigid roles) to distinguish these from one another but
ultimately it is up to the modeller and the envisaged granularity to
decide whether to use them.</skos:editorialNote>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/ps/tick-value">
    <rdfs:comment xml:lang="en">Monetary value of the minimum price increment, calculated as xqo-ps:tick-size * xqo-ps:point-value, expressed in xqo-ps:point-ccy.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">tick value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:seeAlso rdf:resource="http://schema.ga-group.nl/xqo/ps/point-ccy"/>
    <skos:editorialNote xml:lang="en">The note on `xqo-ps:tick-size`
applies here too.  FIBO provides `fibo-der-drc-bsc:hasTickValue` to
capture the tick value (calculated as above) on a per-contract basis.
Otherwise it's up to the modeller to define different contract specs
for front month/back month, or serial month/quarterly, etc.</skos:editorialNote>
  </owl:DatatypeProperty>
</rdf:RDF>

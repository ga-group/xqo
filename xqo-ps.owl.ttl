@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix tempo: <http://purl.org/tempo/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xqo: <http://schema.ga-group.nl/xqo/> .
@prefix xqo-ps: <http://schema.ga-group.nl/xqo/ps/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Ontology header
#################################################################

xqo-ps:
	a	owl:Ontology ;
	dc:abstract	"""xqo-xm is an xqo module that captures product specs."""@en ;
	dc:creator	"Sebastian Freundt"^^xsd:string ;
	dc:description	"""Overview
--------
The exchange quirks ontology (xqo) product specs (xm) module provides
vocabulary to capture the instatiation templates of exchange-listed
derivatives.


Why?
----

Neither FIBO nor FIX deal with analytical workflows like, in this
case, universe selection.


How?
----



Where?
------

This ontology is part of [xqo](http://schema.ga-group.nl/xqo/),
([official github repository](https://github.com/ga-group/xqo/)).

The project's canonical home is <http://schema.ga-group.nl/xqo/ps/>.
"""@en ;
	dcat:downloadURL	<http://schema.ga-group.nl/xqo/ps/rdf> , <http://schema.ga-group.nl/xqo/ps/ttl> ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"xqo-ps -- product specs" ;
	owl:imports	fibo-fbc-fi-fi: , gufo: ;
	owl:versionIRI	<http://schema.ga-group.nl/xqo/0.1/ps/> ;
	owl:versionInfo	"0.1"^^xsd:string ;
	rdfs:label	"xqo-ps"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/xqo> ;
	vann:preferredNamespacePrefix	"xqo-ps"^^xsd:string ;
	vann:preferredNamespaceUri	"http://schema.ga-group.nl/xqo/ps/" .

#################################################################
# Classes
#################################################################

xqo:OperationalVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:variantOf ;
		owl:minCardinality	"1"^^xsd:nonNegativeInteger ;
	] ;
	rdfs:comment	"A variant of a futures contract that inherits all of the economic attributes of the bare contract and only differs in operational ways."@en ;
	rdfs:label	"future variant"@en ;
	rdfs:subClassOf	gufo:Role ;
	skos:editorialNote	"""This class isn't subclass of any particular thing involving """@en .

xqo:ExecutionModality
	a	owl:Class ;
	rdfs:comment	"A benchmark‑priced or rule‑driven mode by which a futures contract is entered or exited, where the execution price is determined not by the continuous limit order book but by a reference benchmark, auction process, or designated price‑formation rule."@en ;
	rdfs:label	"execution modality"@en .

xqo:BTIC
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:BTIC ;
	rdfs:comment	"Modality in which a futures trade is priced relative to the official closing value of an underlying (equity) index, using a negotiated basis applied to the index close to determine the final futures execution price."@en ;
	rdfs:label	"BTIC"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TACO
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TACO ;
	rdfs:comment	"Modality in which a futures trade is priced relative to the official opening value of the underlying (equity) index, using a negotiated basis applied to the cash‑market open to determine the final futures execution price."@en ;
	rdfs:label	"TACO"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAIC
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAIC ;
	rdfs:comment	"Modality in which a futures trade is priced relative to the official closing value of the underlying index without a basis applied to the index close to determine the final futures execution price."@en ;
	rdfs:label	"TAIC"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAL
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAL ;
	rdfs:comment	"Modality in which a futures trade is priced at the last traded price prior to the TAL execution window."@en ;
	rdfs:label	"TAL"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAM
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAM ;
	rdfs:comment	"Modality in which a futures trade is priced at a session marker."@en ;
	rdfs:label	"TAM"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en ;
	skos:scopeNote	"""It is either unambigious which marker is referenced, for example if the trading venue only publishes a single session marker, or TAM markers are indistinguishable, and the combination of base contract plus marker type is not unique.

If one needs to uphold the uniqueness of base contract and marker type, or distinguish several TAM markers specifically they should be introduced as subclasses of xqo:TAM."""@en .

xqo:TAMM
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAMM ;
	rdfs:comment	"Modality in which a futures trade is priced at a morning session's marker."@en ;
	rdfs:label	"TAMM"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAS
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAS ;
	rdfs:comment	"Modality in which a futures trade is priced at the official settlement price of the contract, optionally adjusted by a negotiated tick offset."@en ;
	rdfs:label	"TAS"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TMAC
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TMAC ;
	rdfs:comment	"Modality in which a futures trade is priced at the closing‑auction marker."@en ;
	rdfs:label	"TMAC"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .


xqo:BTICVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:BTIC ;
	] ;
	rdfs:comment	"Operational contract variant that uses the basis-trade-at-index-close execution modality."@en ;
	rdfs:label	"BTIC variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TACOVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TACO ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-cash-open execution modality."@en ;
	rdfs:label	"TACO variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TAICVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAIC ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-index-close execution modality."@en ;
	rdfs:label	"TAIC variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TALVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAL ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-last execution modality."@en ;
	rdfs:label	"TAL variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TAMVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAM ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-marker execution modality."@en ;
	rdfs:label	"TAM variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TAMMVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAMM ;
	] ;
	rdfs:comment	"Operational contract variant that used the trade-at-morning-marker execution modality."@en ;
	rdfs:label	"TAMM variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TASVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAS ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-settlement execution modality."@en ;
	rdfs:label	"TAS variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TMACVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TMAC ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-marker-at-close execution modality."@en ;
	rdfs:label	"TMAC variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

## new module one day

xqo-ps:ContractSpecs
	a	owl:Class ;
	rdfs:comment	"Exchange-specific, instantiation-neutral description of a futures contract."@en ;
	rdfs:label	"contract specs" ;
	rdfs:subClassOf	gufo:Description .

#################################################################
# Object Properties
#################################################################

xqo:variantOf
	a	owl:ObjectProperty ;
	rdfs:comment	"Links an operational futures variant to its outright contract."@en ;
	rdfs:domain	xqo:OperationalVariant ;
	rdfs:label	"variant of"@en ;
	rdfs:subPropertyOf	gufo:isDerivedFrom .

xqo:executedVia
	a	owl:ObjectProperty ;
	rdfs:comment	"Links a futures variant to the execution modality that is used to enter or exit a position."@en ;
	rdfs:label	"executed via"@en ;
	rdfs:range	xqo:ExecutionModality .

xqo:specifiedBy
	a	owl:ObjectProperty ;
	owl:inverseOf	gufo:describes ;
	rdfs:comment	"Links a futures contract to its contract specifications."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"specified by"@en ;
	rdfs:range	xqo-ps:ContractSpecs .


## might move to a submodule

xqo-ps:contract-unit
	a	owl:ObjectProperty ;
	rdfs:comment	""@en ;
	rdfs:label	"contract unit"@en .

xqo-ps:point-ccy
	a	owl:ObjectProperty ;
	rdfs:comment	""@en ;
	rdfs:label	"point currency"@en .


#################################################################
# Datatype Properties
#################################################################

## on specifics

xqo:ordinal
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a futures contract to its ordinal value, implying an ordering and adjacency."@en ;
	rdfs:label	"ordinal"@en ;
	rdfs:range	rdfs:Literal ;
	skos:scopeNote """Note that this value is supposed to be an
ordinal, i.e. non-repetitive, and easily sortable by using ORDER BY in
SPARQL queries.  That means exchange provided discriminators à la H6,
M4, or Z7 don't fit the brief because H7 < Z4, and the Z4 of the
noughties (2004-12) equals the Z4 of the twenties (2024-12).  Use
"2006-03"^^xsd:gYearMonth, "2014-06"^^xsd:gYearMonth, or
"2027-12"^^xsd:gYearMonth instead.  Some contracts don't have an xsd
datatype or an ISO 8601 notation, use raw strings in those cases
(e.g. "2006-Winter", "2010-Season-2", etc.)

The exchange discriminator can be captured by xqo:discriminator."""@en .

xqo:discriminator
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a futures contract to its symbolic discriminator (e.g. 'Z6' in 'CLZ6')"@en ;
	rdfs:label	"discriminator"@en ;
	rdfs:range	rdfs:Literal ;
	skos:scopeNote	"The discriminator can also be captured in a canonical (ordinal) way by xqo:ordinal."@en .

## on specs

xqo:symbol
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a product or contract specification to the exchange's symbol code used for identifying it."@en ;
	rdfs:label	"symbol"@en ;
	rdfs:range	rdfs:Literal .

xqo:logicalCode
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a contract specification to its logical code, thereby roughly identifying a contract family.  Used for ICE products."@en ;
	rdfs:range	rdfs:Literal ;
	rdfs:subPropertyOf	xqo:symbol .

xqo:physicalCode
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a product or contract specification to its physical code, thereby identifying a concrete tradable listing.  Used for ICE products."@en ;;
	rdfs:range	rdfs:Literal ;
	rdfs:subPropertyOf	xqo:symbol .

## might move to a submodule

xqo-ps:contract-size
	a	owl:DatatypeProperty ;
	rdfs:comment	""@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:range	xsd:decimal .

xqo-ps:point-value
	a	owl:DatatypeProperty ;
	rdfs:comment	""@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:range	xsd:decimal .

xqo-ps:tick-size
	a	owl:DatatypeProperty ;
	rdfs:comment	""@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:range	xsd:decimal .

xqo-ps:tick-value
	a	owl:DatatypeProperty ;
	rdfs:comment	""@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:range	xsd:decimal .



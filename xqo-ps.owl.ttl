@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix tempo: <http://purl.org/tempo/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xqo: <http://schema.ga-group.nl/xqo/> .
@prefix xqo-ps: <http://schema.ga-group.nl/xqo/ps/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Ontology header
#################################################################

xqo-ps:
	a	owl:Ontology ;
	dc:abstract	"""xqo-ps is an xqo module that captures product specs."""@en ;
	dc:creator	"Sebastian Freundt"^^xsd:string ;
	dc:description	"""Overview
--------
The exchange quirks ontology (xqo) product specs (ps) module provides
vocabulary to capture the instatiation templates of exchange-listed
derivatives.


Why?
----

Neither FIBO nor FIX deal with analytical workflows like, in this
case, universe selection.


How?
----



Where?
------

This ontology is part of [xqo](http://schema.ga-group.nl/xqo/),
([official github repository](https://github.com/ga-group/xqo/)).

The project's canonical home is <http://schema.ga-group.nl/xqo/ps/>.
"""@en ;
	dcat:downloadURL	<http://schema.ga-group.nl/xqo/ps/rdf> , <http://schema.ga-group.nl/xqo/ps/ttl> ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"xqo-ps -- product specs" ;
	owl:imports	fibo-fnd-acc-cur: , gufo: ;
	owl:versionIRI	<http://schema.ga-group.nl/xqo/0.1/ps/> ;
	owl:versionInfo	"0.1"^^xsd:string ;
	rdfs:label	"xqo-ps"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/xqo> ;
	vann:preferredNamespacePrefix	"xqo-ps"^^xsd:string ;
	vann:preferredNamespaceUri	"http://schema.ga-group.nl/xqo/ps/" .

#################################################################
# Classes
#################################################################

xqo-ps:ContractSpecs
	a	owl:Class ;
	rdfs:comment	"Exchange-specific, instantiation-neutral description of a futures contract."@en ;
	rdfs:label	"contract specs" ;
	rdfs:subClassOf	gufo:Description .

## supporting roles

xqo-ps:FrontMonth
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo-ps:BackMonth
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo-ps:SerialMonth
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo-ps:Quarterly
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo-ps:ShortDated
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .


#################################################################
# Object Properties
#################################################################

xqo-ps:contract-unit
	a	owl:ObjectProperty ;
	rdfs:comment	"Unit of the physical or notional amount of the underlying."@en ;
	rdfs:label	"contract unit"@en ;
	rdfs:range	qudt:Unit ;
	rdfs:seeAlso	xqo-ps:contract-size .

xqo-ps:point-ccy
	a	owl:ObjectProperty ;
	rdfs:comment	"Currency in which the monetary value of a one-point move is expressed."@en ;
	rdfs:label	"point currency"@en ;
	rdfs:range	fibo-fnd-acc-cur:Currency ;
	rdfs:seeAlso	xqo-ps:point-value .

xqo-ps:quote-unit
	a	owl:ObjectProperty ;
	owl:deprecated	true ;
	rdfs:comment	"Unit of quoting, deprecated.  Replaced by the 4-tuple of xqo-ps:contract-value, xqo-ps:contract-unit, xqo-ps:point-value, and xqo-ps:point-ccy.  Calculated as (xqo-ps:point-value / xqo-ps:contract-value) * (xqo-ps:point-ccy / xqo-ps:contract-unit)."@en ;
	rdfs:label	"quote unit"@en ;
	rdfs:range	qudt:Unit ;
	rdfs:seeAlso	xqo-ps:contract-unit , xqo-ps:point-value .

#################################################################
# Datatype Properties
#################################################################

xqo-ps:contract-size
	a	owl:DatatypeProperty ;
	rdfs:comment	"Physical or notional amount of the underlying that one contract controls."@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:label	"contract size"@en ;
	rdfs:range	xsd:decimal ;
	rdfs:seeAlso	xqo-ps:contract-unit ;
	skos:editorialNote """Certain products stipulate different
contract sizes depending on the month, the quarter, the semester, or
the year in question.  For example if the contract were to specify a
fixed amount per hour (as is the case for electricity), the resulting
contract can be of size 672, 696, 719, 720, 721, 743, 744, 745, for
months of 28, 29, 30, or 31 days and possibly accounting for the
beginning or the end of daylight saving."""@en .

xqo-ps:point-value
	a	owl:DatatypeProperty ;
	rdfs:comment	"Monetary value of a one-point move."@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:label	"point value"@en ;
	rdfs:range	xsd:decimal ;
	rdfs:seeAlso	xqo-ps:point-ccy .

xqo-ps:tick-size
	a	owl:DatatypeProperty ;
	rdfs:comment	"Minimum price increment in points."@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:label	"tick size"@en ;
	rdfs:range	xsd:decimal ;
	skos:editorialNote """Some exchanges stipulate different tick
sizes depending on whether the contract is, say, the front month (as
opposed to back month and later), or e.g. a serial month (as opposed
to a weekly or quarterly).  xqo provides supporting classes
(anti-rigid roles) to distinguish these from one another but
ultimately it is up to the modeller and the envisaged granularity to
decide whether to use them."@en .

xqo-ps:tick-value
	a	owl:DatatypeProperty ;
	rdfs:comment	"Monetary value of the minimum price increment, calculated as xqo-ps:tick-size * xqo-ps:point-value, expressed in xqo-ps:point-ccy."@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:label	"tick value"@en ;
	rdfs:range	xsd:decimal ;
	rdfs:seeAlso	xqo-ps:point-ccy .

xqo-ps:contract-months
	a	owl:DatatypeProperty ;
	rdfs:comment	"Indicator of concurrently active contracts in truffle syntax."@en ;
	rdfs:domain	xqo-ps:ContractSpecs ;
	rdfs:label	"contract months"@en ;
	rdfs:range	rdfs:Literal .


#################################################################
# Examples
#################################################################

<http://example.com/bbg/CLA_Comdty>
	xqo-ps:contract-size	1000 ;
	xqo-ps:contract-unit	unit:Barrel .

<http://example.com/cme/CLZ6_Comdty>
	rdfs:label	"CLZ6" ;
	xqo-ps:specifiedBy	<http://example.com/bbg/CLA_Comdty> ;
	xqo:ordinal	"2026-12"^^xsd:gYearMonth .

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix tempo: <http://purl.org/tempo/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xqo: <http://schema.ga-group.nl/xqo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Ontology header
#################################################################

xqo:
	a	owl:Ontology ;
	dc:abstract	"""xqo is a lightweight ontology based on fibo's derivatives ontology that captures implementation (i.e. exchange) specific details."""@en ;
	dc:creator	"Sebastian Freundt"^^xsd:string ;
	dc:description	"""Overview
--------
The exchange quirks ontology (xqo) provides vocabulary to classify and
relate certain operational contract variants of exchange-listed
derivatives, to capture the instantiation templates of exchange-listed
derivatives, as well as their instantiations.



Why?
----

FIBO's official ontology (much like FIX) stop at exchange-specific
implementations, and instead refer to the possibility of extending the
standard unofficially as needed.  And while FIX covers pre-trade, FIBO
is generally post-trade, and neither cover analytical workflows like
universe selection, exchange selection, order type selection, trading
parameters nor important dates associated with the exposure.


How?
----

A class, `xqo:ExecutionModality` is introduced, and the most
prominent modalities are identified and introduced as classes in their
own right.  Moreover, a class `xqo:OperationalVariant` is
introduced, itself a subclass of `gufo:Role` to capture the
operational contract (or chain, or synthesis) as a variant of the
outright contract (or chain, or synthesis).  Then for each of the
modalities a variant is introduced, itself a subclass of
`xqo:OperationalVariant` which is inferred if a resource states

    R xqo:executedVia xqo:<Modality> .

=>

    R a xqo:<Modality>Variant .

and, conversely:

    R a xqo:<Modality>Variant .

=>

    R xqo:executedVia [
            a xqo:<Modality> 
    ] .



Where?
------

The [official github repository](https://github.com/ga-group/xqo/)
contains the published ontology.

The project's canonical home is <http://schema.ga-group.nl/xqo/>.
"""@en ;
	dcat:downloadURL	<http://schema.ga-group.nl/xqo/rdf> , <http://schema.ga-group.nl/xqo/ttl> ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"xqo -- exchange quirks ontology" ;
	owl:imports	fibo-fbc-fi-fi: , fibo-fnd-acc-cur: , gufo: ;
	owl:versionIRI	<http://schema.ga-group.nl/xqo/0.1/> ;
	owl:versionInfo	"0.1"^^xsd:string ;
	rdfs:label	"xqo"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/xqo> ;
	vann:preferredNamespacePrefix	"xqo"^^xsd:string ;
	vann:preferredNamespaceUri	"http://schema.ga-group.nl/xqo/" .

#################################################################
# Classes
#################################################################

## variants

xqo:OperationalVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:variantOf ;
		owl:minCardinality	"1"^^xsd:nonNegativeInteger ;
	] ;
	rdfs:comment	"A variant of a futures contract that inherits all of the economic attributes of the bare contract and only differs in operational ways."@en ;
	rdfs:label	"future variant"@en ;
	rdfs:subClassOf	gufo:Role ;
	skos:editorialNote	"""This class isn't subclass of any particular thing involving """@en .

xqo:ExecutionModality
	a	owl:Class ;
	rdfs:comment	"A benchmark‑priced or rule‑driven mode by which a futures contract is entered or exited, where the execution price is determined not by the continuous limit order book but by a reference benchmark, auction process, or designated price‑formation rule."@en ;
	rdfs:label	"execution modality"@en .

xqo:BTIC
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:BTIC ;
	rdfs:comment	"Modality in which a futures trade is priced relative to the official closing value of an underlying (equity) index, using a negotiated basis applied to the index close to determine the final futures execution price."@en ;
	rdfs:label	"BTIC"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TACO
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TACO ;
	rdfs:comment	"Modality in which a futures trade is priced relative to the official opening value of the underlying (equity) index, using a negotiated basis applied to the cash‑market open to determine the final futures execution price."@en ;
	rdfs:label	"TACO"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAIC
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAIC ;
	rdfs:comment	"Modality in which a futures trade is priced relative to the official closing value of the underlying index without a basis applied to the index close to determine the final futures execution price."@en ;
	rdfs:label	"TAIC"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAL
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAL ;
	rdfs:comment	"Modality in which a futures trade is priced at the last traded price prior to the TAL execution window."@en ;
	rdfs:label	"TAL"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAM
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAM ;
	rdfs:comment	"Modality in which a futures trade is priced at a session marker."@en ;
	rdfs:label	"TAM"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en ;
	skos:scopeNote	"""It is either unambigious which marker is referenced, for example if the trading venue only publishes a single session marker, or TAM markers are indistinguishable, and the combination of base contract plus marker type is not unique.

If one needs to uphold the uniqueness of base contract and marker type, or distinguish several TAM markers specifically they should be introduced as subclasses of xqo:TAM."""@en .

xqo:TAMM
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAMM ;
	rdfs:comment	"Modality in which a futures trade is priced at a morning session's marker."@en ;
	rdfs:label	"TAMM"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TAS
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TAS ;
	rdfs:comment	"Modality in which a futures trade is priced at the official settlement price of the contract, optionally adjusted by a negotiated tick offset."@en ;
	rdfs:label	"TAS"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .

xqo:TMAC
	a	owl:Class ;
	a	xqo:ExecutionModality , xqo:TMAC ;
	rdfs:comment	"Modality in which a futures trade is priced at the closing‑auction marker."@en ;
	rdfs:label	"TMAC"@en ;
	skos:editorialNote	"type-punning is used to allow users to either generically reference the execution modality, or to create their own subclasses, possibly encoding further exchange-specific details"@en .


xqo:BTICVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:BTIC ;
	] ;
	rdfs:comment	"Operational contract variant that uses the basis-trade-at-index-close execution modality."@en ;
	rdfs:label	"BTIC variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TACOVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TACO ;
	] ;
	rdfs:comment	"Operational contract variant that uses the (basis-)trade-at-cash-open execution modality."@en ;
	rdfs:label	"TACO variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TAICVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAIC ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-index-close execution modality."@en ;
	rdfs:label	"TAIC variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TALVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAL ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-last execution modality."@en ;
	rdfs:label	"TAL variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TAMVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAM ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-marker execution modality."@en ;
	rdfs:label	"TAM variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TAMMVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAMM ;
	] ;
	rdfs:comment	"Operational contract variant that used the trade-at-morning-marker execution modality."@en ;
	rdfs:label	"TAMM variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TASVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TAS ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-at-settlement execution modality."@en ;
	rdfs:label	"TAS variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

xqo:TMACVariant
	a	owl:Class ;
	owl:equivalentClass	[
		a	owl:Restriction ;
		owl:onProperty	xqo:executedVia ;
		owl:someValuesFrom	xqo:TMAC ;
	] ;
	rdfs:comment	"Operational contract variant that uses the trade-marker-at-close execution modality."@en ;
	rdfs:label	"TMAC variant"@en ;
	rdfs:subClassOf	xqo:OperationalVariant .

## specs

xqo:ContractSpecs
	a	owl:Class ;
	rdfs:comment	"Exchange-specific, instantiation-neutral description of a futures contract."@en ;
	rdfs:label	"contract specs"@en ;
	rdfs:subClassOf	gufo:Description .

xqo:ComboSpecs
	a	owl:Class ;
	rdfs:comment	"Exchange-specific, instantiation-neutral description of futures comboes."@en ;
	rdfs:label	"combo specs"@en ;
	rdfs:subClassOf	xqo:ContractSpecs .

xqo:StripSpecs
	a	owl:Class ;
	rdfs:comment	"Exchange-specific, instantiation-neutral description of futures strips."@en ;
	rdfs:label	"strip specs"@en ;
	rdfs:subClassOf	xqo:ComboSpecs .

xqo:SpreadSpecs
	a	owl:Class ;
	rdfs:comment	"Exchange-specific, instantiation-neutral description of futures spreads."@en ;
	rdfs:label	"spread specs"@en ;
	rdfs:subClassOf	xqo:ComboSpecs .

## supporting roles

xqo:FrontMonth
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo:BackMonth
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo:SerialMonth
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo:Quarterly
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .

xqo:ShortDated
	a	owl:Class ;
	rdfs:subClassOf	gufo:Role .


xqo:FuturesCombo
	a	owl:Class ;
	owl:equivalentClass [
		a	owl:Restriction ;
		owl:onProperty	xqo:specifiedBy ;
		owl:someValuesFrom	xqo:ComboSpecs ;
	] ;
	rdfs:comment	"Combination of futures contracts that are traded or analysed together as a package."@en ;
	rdfs:label	"futures combo"@en ;
	rdfs:subClassOf	fibo-fbc-fi-fi:Future .

xqo:FuturesStrip
	a	owl:Class ;
	owl:equivalentClass [
		a	owl:Restriction ;
		owl:onProperty	xqo:specifiedBy ;
		owl:someValuesFrom	xqo:StripSpecs ;
	] ;
	rdfs:comment	"Futures combo that covers consecutive delivery months or quarters."@en ;
	rdfs:label	"futures strip"@en ;
	rdfs:subClassOf	xqo:FuturesCombo .

xqo:FuturesSpread
	a	owl:Class ;
	owl:equivalentClass [
		a	owl:Restriction ;
		owl:onProperty	xqo:specifiedBy ;
		owl:someValuesFrom	xqo:SpreadSpecs ;
	] ;
	rdfs:comment	"Futures combo that simultaneously buys and sells different outrights."@en ;
	rdfs:label	"futures spread"@en ;
	rdfs:subClassOf	xqo:FuturesCombo .

xqo:Pack
	a	owl:Class ;
	rdfs:comment	"Standardised strip of four consecutive quarterly contracts in a colour band."@en ;
	rdfs:label	"pack"@en ;
	rdfs:subClassOf	xqo:FuturesStrip .

xqo:Bundle
	a	owl:Class ;
	rdfs:comment	"Standardised bundle of packs, e.g. 2-year bundle equals white pack plus red pack."@en ;
	rdfs:label	"bundle"@en ;
	rdfs:subClassOf	xqo:FuturesStrip .

xqo:Leg
	a	owl:Class ;
	rdfs:comment	"Leg of a futures combo."@en ;
	rdfs:label	"leg"@en .


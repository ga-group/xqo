@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix tempo: <http://purl.org/tempo/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xqo: <http://schema.ga-group.nl/xqo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Ontology header
#################################################################

xqo:
	a	owl:Ontology ;
	dc:abstract	"""xqo is a lightweight ontology based on fibo's derivatives ontology that captures implementation (i.e. exchange) specific details."""@en ;
	dc:creator	"Sebastian Freundt"^^xsd:string ;
	dc:description	"""Overview
--------
The exchange quirks ontology (xqo) provides vocabulary .


Why?
----

FIBO's official ontology (much like FIX) stop at exchange-specific
implementations, and instead refer to the possibility of extending the
standard unofficially as needed.  And while FIX covers pre-trade, FIBO
is generally post-trade, and neither cover analytical workflows like
universe selection, exchange selection, order type selection, etc.


Where?
------

The [official github repository](https://github.com/ga-group/xqo/)
contains the published ontology.

The project's canonical home is <http://schema.ga-group.nl/xqo/>.
"""@en ;
	dcat:downloadURL	<http://schema.ga-group.nl/xqo/rdf> , <http://schema.ga-group.nl/xqo/ttl> ;
	dct:creator	<https://orcid.org/0000-0002-7352-2825> ;
	dct:format	"text/turtle"^^xsd:string ;
	dct:issued	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:language	"en"^^xsd:language ;
	dct:license	<https://creativecommons.org/licenses/by-sa/4.0/> ;
	dct:modified	"2026-10-01T05:00:00Z"^^xsd:dateTime ;
	dct:publisher	<https://orcid.org/0000-0002-7352-2825> ;
	dct:title	"xqo -- exchange quirks ontology" ;
	owl:imports	fibo-fbc-fi-fi: , gufo: ;
	owl:versionIRI	<http://schema.ga-group.nl/xqo/0.1/> ;
	owl:versionInfo	"0.1"^^xsd:string ;
	rdfs:label	"xqo"@en ;
	rdfs:seeAlso	<https://github.com/ga-group/xqo> ;
	vann:preferredNamespacePrefix	"xqo"^^xsd:string ;
	vann:preferredNamespaceUri	"http://schema.ga-group.nl/xqo/" .

#################################################################
# Classes
#################################################################


#################################################################
# Object Properties
#################################################################



#################################################################
# Datatype Properties
#################################################################

## on specifics

xqo:ordinal
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a futures contract to its ordinal value, implying an ordering and adjacency."@en ;
	rdfs:label	"ordinal"@en ;
	rdfs:range	rdfs:Literal ;
	skos:scopeNote """Note that this value is supposed to be an
ordinal, i.e. non-repetitive, and easily sortable by using ORDER BY in
SPARQL queries.  That means exchange provided discriminators à la H6,
M4, or Z7 don't fit the brief because H7 < Z4, and the Z4 of the
noughties (2004-12) equals the Z4 of the twenties (2024-12).  Use
"2006-03"^^xsd:gYearMonth, "2014-06"^^xsd:gYearMonth, or
"2027-12"^^xsd:gYearMonth instead.  Some contracts don't have an xsd
datatype or an ISO 8601 notation, use raw strings in those cases
(e.g. "2006-Winter", "2010-Season-2", etc.)

The exchange discriminator can be captured by xqo:discriminator."""@en .

xqo:discriminator
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a futures contract to its symbolic discriminator (e.g. 'Z6' in 'CLZ6')"@en ;
	rdfs:label	"discriminator"@en ;
	rdfs:range	rdfs:Literal ;
	skos:scopeNote	"The discriminator can also be captured in a canonical (ordinal) way by xqo:ordinal."@en .

## on specs

xqo:symbol
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a product or contract specification to the exchange's symbol code used for identifying it."@en ;
	rdfs:label	"symbol"@en ;
	rdfs:range	rdfs:Literal .

xqo:logicalCode
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a contract specification to its logical code, thereby roughly identifying a contract family.  Used for ICE products."@en ;
	rdfs:range	rdfs:Literal ;
	rdfs:subPropertyOf	xqo:symbol .

xqo:physicalCode
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a product or contract specification to its physical code, thereby identifying a concrete tradable listing.  Used for ICE products."@en ;;
	rdfs:range	rdfs:Literal ;
	rdfs:subPropertyOf	xqo:symbol .



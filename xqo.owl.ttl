#################################################################
# Object Properties
#################################################################

xqo:composedOf
	a	owl:ObjectProperty ;
	owl:inverseOf	xqo:componentOf ;
	rdfs:comment	"Relates a concept to the futures contracts it is composed of."@en ;
	rdfs:label	"composed of"@en .

xqo:componentOf
	a	owl:ObjectProperty ;
	owl:inverseOf	xqo:composedOf ;
	rdfs:comment	"Relates a futures contract to a composition concept."@en ;
	rdfs:label	"component of"@en ;
	rdfs:subPropertyOf	gufo:isProperPartOf .

## specs

xqo:specifiedBy
	a	owl:ObjectProperty ;
	owl:inverseOf	gufo:describes ;
	rdfs:comment	"Links a futures contract to its contract specifications."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"specified by"@en ;
	rdfs:range	xqo:ContractSpecs .

xqo:contract-unit
	a	owl:ObjectProperty ;
	rdfs:comment	"Unit of the physical or notional amount of the underlying."@en ;
	rdfs:label	"contract unit"@en ;
	rdfs:range	qudt:Unit ;
	rdfs:seeAlso	xqo:contract-size .

xqo:point-ccy
	a	owl:ObjectProperty ;
	rdfs:comment	"Currency in which the monetary value of a one-point move is expressed."@en ;
	rdfs:label	"point currency"@en ;
	rdfs:range	fibo-fnd-acc-cur:Currency ;
	rdfs:seeAlso	xqo:point-value .

xqo:quote-unit
	a	owl:ObjectProperty ;
	owl:deprecated	true ;
	rdfs:comment	"Unit of quoting, deprecated.  Replaced by the 4-tuple of xqo:contract-value, xqo:contract-unit, xqo:point-value, and xqo:point-ccy.  Calculated as (xqo:point-value / xqo:contract-value) * (xqo:point-ccy / xqo:contract-unit)."@en ;
	rdfs:label	"quote unit"@en ;
	rdfs:range	qudt:Unit ;
	rdfs:seeAlso	xqo:contract-unit , xqo:point-value .

xqo:stripOf
	a	owl:ObjectProperty ;
	rdfs:comment	"Relates a futures strip specification to the contract specs that it is made up of."@en ;
	rdfs:domain	xqo:StripSpecs ;
	rdfs:label	"strip of"@en ;
	rdfs:range	xqo:ContractSpecs .

xqo:spreadOf
	a	owl:ObjectProperty ;
	rdfs:comment	"Relates a futures spread specification to the contract specs of its legs."@en ;
	rdfs:domain	xqo:SpreadSpecs ;
	rdfs:label	"spread of"@en ;
	rdfs:range	xqo:ContractSpecs .


## variants

xqo:variantOf
	a	owl:ObjectProperty ;
	rdfs:comment	"Links an operational futures variant to its outright contract."@en ;
	rdfs:domain	xqo:OperationalVariant ;
	rdfs:label	"variant of"@en ;
	rdfs:subPropertyOf	gufo:isDerivedFrom .

xqo:executedVia
	a	owl:ObjectProperty ;
	rdfs:comment	"Links a futures variant to the execution modality that is used to enter or exit a position."@en ;
	rdfs:domain	xqo:OperationalVariant ;
	rdfs:label	"executed via"@en ;
	rdfs:range	xqo:ExecutionModality .

## legs

xqo:leg
	a	owl:ObjectProperty ;
	rdfs:comment	"Links a futures combo to its legs."@en ;
	rdfs:domain	xqo:FuturesCombo ;
	rdfs:label	"leg"@en ;
	rdfs:range	xqo:Leg ;
	rdfs:subPropertyOf	gufo:hasProperPart .

xqo:contract
	a	owl:ObjectProperty ;
	rdfs:comment	"Links a leg to the futures contract traded by that leg."@en ;
	rdfs:domain	xqo:Leg ;
	rdfs:label	"contract"@en ;
	rdfs:range	fibo-fbc-fi-fi:Future .


#################################################################
# Datatype Properties
#################################################################

## on specifics

xqo:ordinal
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a futures contract to its ordinal value, implying an ordering and adjacency."@en ;
	rdfs:label	"ordinal"@en ;
	rdfs:range	rdfs:Literal ;
	skos:scopeNote """Note that this value is supposed to be an
ordinal, i.e. non-repetitive, and easily sortable by using ORDER BY in
SPARQL queries.  That means exchange provided discriminators à la H6,
M4, or Z7 don't fit the brief because H7 < Z4, and the Z4 of the
noughties (2004-12) equals the Z4 of the twenties (2024-12).  Use
"2006-03"^^xsd:gYearMonth, "2014-06"^^xsd:gYearMonth, or
"2027-12"^^xsd:gYearMonth instead.  Some contracts don't have an xsd
datatype or an ISO 8601 notation, use raw strings in those cases
(e.g. "2006-Winter", "2010-Season-2", etc.)

The exchange discriminator can be captured by xqo:discriminator."""@en .

xqo:discriminator
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a futures contract to its symbolic discriminator (e.g. 'Z6' in 'CLZ6')"@en ;
	rdfs:label	"discriminator"@en ;
	rdfs:range	rdfs:Literal ;
	skos:scopeNote	"The discriminator can also be captured in a canonical (ordinal) way by xqo:ordinal."@en .

xqo:symbol
	a	owl:DatatypeProperty ;
	rdfs:comment	"Relates a product or contract specification to the exchange's symbol code used for identifying it."@en ;
	rdfs:label	"symbol"@en ;
	rdfs:range	rdfs:Literal .

## specs

xqo:contract-size
	a	owl:DatatypeProperty ;
	rdfs:comment	"Physical or notional amount of the underlying that one contract controls."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"contract size"@en ;
	rdfs:range	xsd:decimal ;
	rdfs:seeAlso	xqo:contract-unit ;
	skos:editorialNote	"""Certain products stipulate different
contract sizes depending on the month, the quarter, the semester, or
the year in question.  For example if the contract were to specify a
fixed amount per hour (as is the case for electricity), the resulting
contract can be of size 672, 696, 719, 720, 721, 743, 744, 745, for
months of 28, 29, 30, or 31 days and possibly accounting for the
beginning or the end of daylight saving."""@en .

xqo:point-value
	a	owl:DatatypeProperty ;
	rdfs:comment	"Monetary value of a one-point move."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"point value"@en ;
	rdfs:range	xsd:decimal ;
	rdfs:seeAlso	xqo:point-ccy .

xqo:tick-size
	a	owl:DatatypeProperty ;
	rdfs:comment	"Minimum price increment in points."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"tick size"@en ;
	rdfs:range	xsd:decimal ;
	skos:editorialNote	"""Some exchanges stipulate different
tick sizes depending on whether the contract is, say, the front month
(as opposed to back month and later), or e.g. a serial month (as
opposed to a weekly or quarterly).  xqo provides supporting classes
(anti-rigid roles) to distinguish these from one another but
ultimately it is up to the modeller and the envisaged granularity to
decide whether to use them."""@en .

xqo:tick-value
	a	owl:DatatypeProperty ;
	rdfs:comment	"Monetary value of the minimum price increment, calculated as xqo:tick-size * xqo:point-value, expressed in xqo:point-ccy."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"tick value"@en ;
	rdfs:range	xsd:decimal ;
	rdfs:seeAlso	xqo:point-ccy ;
	skos:editorialNote	"""The note on `xqo:tick-size`
applies here too.  FIBO provides `fibo-der-drc-bsc:hasTickValue` to
capture the tick value (calculated as above) on a per-contract basis.
Otherwise it's up to the modeller to define different contract specs
for front month/back month, or serial month/quarterly, etc."""@en .

xqo:contract-months
	a	owl:DatatypeProperty ;
	rdfs:comment	"Indicator of concurrently active contracts in truffle syntax."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"contract months"@en ;
	rdfs:range	rdfs:Literal .

xqo:listed-from
	a	owl:DatatypeProperty ;
	rdfs:comment	"Date on which instantiations of the contract specs become available (again)."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"listed from"@en ;
	rdfs:range	xsd:date ;
	rdfs:subPropertyOf	tempo:validFrom .

xqo:listed-till
	a	owl:DatatypeProperty ;
	rdfs:comment	"Date on which no instantiations of the contract specs are available anymore."@en ;
	rdfs:domain	xqo:ContractSpecs ;
	rdfs:label	"listed till"@en ;
	rdfs:range	xsd:date ;
	rdfs:subPropertyOf	tempo:validTill .

## combos

xqo:strip-length
	a	owl:DatatypeProperty ;
	rdfs:comment	"Number of consecutive contracts that make up a strip."@en ;
	rdfs:domain	xqo:StripSpecs ;
	rdfs:label	"strip length"@en ;
	rdfs:range	xsd:decimal .

## specifics

xqo:first-notice
	a	owl:DatatypeProperty ;
	rdfs:comment	"First day on which buyers are notified of their obligation take delivery."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"first notice date"@en ;
	rdfs:range	xsd:date .

xqo:last-notice
	a	owl:DatatypeProperty ;
	rdfs:comment	"Final day on which buyers are notified of their obligation take delivery."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"last notice date"@en ;
	rdfs:range	xsd:date .

xqo:first-intent
	a	owl:DatatypeProperty ;
	rdfs:comment	"First day on which sellers can express their intent to deliver."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"first intent date"@en ;
	rdfs:range	xsd:date ;
	skos:altLabel	"first position date"@en .

xqo:last-intent
	a	owl:DatatypeProperty ;
	rdfs:comment	"Final day on which sellers can express their intent or modify a previously expressed intent to deliver."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"last intent date"@en ;
	rdfs:range	xsd:date ;
	skos:altLabel	"last position date"@en .

xqo:first-trade
	a	owl:DatatypeProperty ;
	rdfs:comment	"First day on which a contract is available for trading."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"first trade date"@en ;
	rdfs:range	xsd:date .

xqo:last-trade
	a	owl:DatatypeProperty ;
	rdfs:comment	"Final day on which a contract is available for trading."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"last trade trade"@en ;
	rdfs:range	xsd:date .

xqo:first-delivery
	a	owl:DatatypeProperty ;
	rdfs:comment	"First day on which to take or make a delivery."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"first delivery date"@en ;
	rdfs:range	xsd:date .

xqo:last-delivery
	a	owl:DatatypeProperty ;
	rdfs:comment	"Final day on which to take or make a delivery."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"last delivery date"@en ;
	rdfs:range	xsd:date .

xqo:final-settlement
	a	owl:DatatypeProperty ;
	rdfs:comment	"Date on which all obligations are finally fulfilled and cash or securities are exchanged."@en ;
	rdfs:domain	fibo-fbc-fi-fi:Future ;
	rdfs:label	"final settlement date"@en ;
	rdfs:range	xsd:date .

## legs

xqo:ratio
	a	owl:DatatypeProperty ;
	rdfs:comment	"Number of contracts in this leg.  Negative for short position, positive for long position."@en ;
	rdfs:domain	xqo:Leg ;
	rdfs:label	"ratio"@en ;
	rdfs:range	xsd:decimal .



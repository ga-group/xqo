<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="owl2html.xslt.xml"?>
<rdf:RDF xmlns:dc="http://purl.org/dc/elements/1.1/"
   xmlns:dcat="http://www.w3.org/ns/dcat#"
   xmlns:dct="http://purl.org/dc/terms/"
   xmlns:fibo-fbc-fi-fi="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/"
   xmlns:gufo="http://purl.org/nemo/gufo#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:pav="http://purl.org/pav/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sh="http://www.w3.org/ns/shacl#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:swrl="http://www.w3.org/2003/11/swrl#"
   xmlns:tempo="http://purl.org/tempo/"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:xqo="http://schema.ga-group.nl/xqo/"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <xqo:TASVariant rdf:about="http://example.com/cme/CLTZ2">
    <xqo:variantOf rdf:resource="http://example.com/cme/CLZ2"/>
    <rdfs:label>CLTZ2</rdfs:label>
  </xqo:TASVariant>
  <fibo-fbc-fi-fi:Future rdf:about="http://example.com/cme/CLZ2">
    <rdfs:label>CLZ2</rdfs:label>
  </fibo-fbc-fi-fi:Future>
  <rdf:Description rdf:about="http://example.com/cme/CLmmZ2">
    <xqo:executedVia rdf:resource="http://schema.ga-group.nl/xqo/TAMM"/>
    <xqo:variantOf rdf:resource="http://example.com/cme/CLZ2"/>
    <rdfs:label>CLTZ2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.com/cme/DAmmZ2">
    <xqo:executedVia rdf:resource="http://schema.ga-group.nl/xqo/CME_TAMM"/>
    <xqo:variantOf rdf:resource="http://example.com/cme/CLZ2"/>
    <rdfs:label>DAmmZ2</rdfs:label>
  </rdf:Description>
  <owl:Ontology rdf:about="http://schema.ga-group.nl/xqo/">
    <dc:abstract xml:lang="en">xqo is a lightweight ontology based on fibo's derivatives ontology that captures implementation (i.e. exchange) specific details.</dc:abstract>
    <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sebastian Freundt</dc:creator>
    <dc:description xml:lang="en">Overview
--------
</dc:description>
    <dct:creator rdf:resource="https://orcid.org/0000-0002-7352-2825"/>
    <dct:format rdf:datatype="http://www.w3.org/2001/XMLSchema#string">text/turtle</dct:format>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-01T05:00:00Z</dct:issued>
    <dct:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dct:language>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-01T05:00:00Z</dct:modified>
    <dct:publisher rdf:resource="https://orcid.org/0000-0002-7352-2825"/>
    <dct:title>xqo -- exchange quirks ontology</dct:title>
    <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xqo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://schema.ga-group.nl/xqo/</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="en">xqo</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://github.com/ga-group/xqo"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/"/>
    <owl:versionIRI rdf:resource="http://schema.ga-group.nl/xqo/0.1/"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1</owl:versionInfo>
    <dcat:downloadURL rdf:resource="http://schema.ga-group.nl/xqo/rdf"/>
    <dcat:downloadURL rdf:resource="http://schema.ga-group.nl/xqo/ttl"/>
  </owl:Ontology>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/BTIC">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/BTIC"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced relative to the official closing value of an underlying (equity) index, using a negotiated basis that is applied to the index close to determine the final futures execution price.</rdfs:comment>
    <rdfs:label xml:lang="en">BTIC</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/BTICVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that uses the basis-trade-at-index-close execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">BTIC variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/BTIC"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <xqo:TAMM rdf:about="http://schema.ga-group.nl/xqo/CME_TAMM"/>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/ExecutionModality">
    <rdfs:comment xml:lang="en">A benchmark‑priced or rule‑driven mode by which a futures contract is entered or exited, where the execution price is determined not by the continuous limit order book but by a reference benchmark, auction process, or designated price‑formation rule.</rdfs:comment>
    <rdfs:label xml:lang="en">execution modality</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Mode"/>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/FuturesVariant">
    <rdfs:comment xml:lang="en">A variant of a futures contract that inherits all of the economic attributes of the bare contract and only differs in operational ways.</rdfs:comment>
    <rdfs:label xml:lang="en">future variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/variantOf"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TACO">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/TACO"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced relative to the official opening value of the underlying (equity) index, using a negotiated basis applied to the cash‑market open to determine the final futures execution price.</rdfs:comment>
    <rdfs:label xml:lang="en">TACO</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TACOVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that uses the trade-at-cash-open execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">TACO variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/TACO"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TAL">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/TAL"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced at the last traded price prior to the TAL execution window.</rdfs:comment>
    <rdfs:label xml:lang="en">TAL</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TALVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that uses the trade-at-last execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">TAL variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/TAL"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TAM">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/TAM"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced at a session marker.</rdfs:comment>
    <rdfs:label xml:lang="en">TAM</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TAMM">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/TAMM"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced at a morning session's marker.</rdfs:comment>
    <rdfs:label xml:lang="en">TAMM</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TAMMVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that used the trade-at-morning-marker execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">TAMM variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/TAMM"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TAMVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that uses the trade-at-marker execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">TAM variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/TAM"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TAS">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/TAS"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced at the official settlement price of the contract, optionally adjusted by a negotiated tick offset.</rdfs:comment>
    <rdfs:label xml:lang="en">TAS</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TASVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that uses the trade-at-settlement execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">TAS variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/TAS"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TMAC">
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdf:type rdf:resource="http://schema.ga-group.nl/xqo/TMAC"/>
    <rdfs:comment xml:lang="en">Modality in which a futures trade is priced at the closing‑auction marker.</rdfs:comment>
    <rdfs:label xml:lang="en">TMAC</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://schema.ga-group.nl/xqo/TMACVariant">
    <rdfs:comment xml:lang="en">Operational contract variant that uses the trade-marker-at-close execution modality.</rdfs:comment>
    <rdfs:label xml:lang="en">TMAC variant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://schema.ga-group.nl/xqo/executedVia"/>
        <owl:someValuesFrom rdf:resource="http://schema.ga-group.nl/xqo/TMAC"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://schema.ga-group.nl/xqo/executedVia">
    <rdfs:comment xml:lang="en">Links a futures variant to the execution modality that is used to enter or exit a position.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <rdfs:label xml:lang="en">executed via</rdfs:label>
    <rdfs:range rdf:resource="http://schema.ga-group.nl/xqo/ExecutionModality"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#participatesIn"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://schema.ga-group.nl/xqo/variantOf">
    <rdfs:comment xml:lang="en">Links a futures variant to its outright contract.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/FuturesVariant"/>
    <rdfs:label xml:lang="en">variant of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#isDerivedFrom"/>
  </owl:ObjectProperty>
</rdf:RDF>

    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-01T05:00:00Z</dct:modified>
    <dct:publisher rdf:resource="https://orcid.org/0000-0002-7352-2825"/>
    <dct:title>xqo-sp -- specific products</dct:title>
    <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xqo-sp</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://schema.ga-group.nl/xqo/sp/</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="en">xqo-sp</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://github.com/ga-group/xqo"/>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <owl:imports rdf:resource="http://schema.ga-group.nl/xqo/ps/"/>
    <owl:imports rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/"/>
    <owl:versionIRI rdf:resource="http://schema.ga-group.nl/xqo/0.1/sp/"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1</owl:versionInfo>
    <dcat:downloadURL rdf:resource="http://schema.ga-group.nl/xqo/sp/rdf"/>
    <dcat:downloadURL rdf:resource="http://schema.ga-group.nl/xqo/sp/ttl"/>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/sp/final-settlement">
    <rdfs:comment xml:lang="en">Indicator of concurrently active contracts in truffle syntax.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">final settlement date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/sp/first-delivery">
    <rdfs:comment xml:lang="en">Monetary value of the minimum price increment, calculated as xqo-ps:tick-size * xqo-ps:point-value, expressed in xqo-ps:point-ccy.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">first delivery date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/sp/first-notice">
    <rdfs:comment xml:lang="en">Physical or notional amount of the underlying that one contract controls.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">first notice date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/sp/first-trade">
    <rdfs:comment xml:lang="en">Monetary value of a one-point move.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">first trade date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/sp/last-delivery">
    <rdfs:comment xml:lang="en">Indicator of concurrently active contracts in truffle syntax.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">last delivery date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://schema.ga-group.nl/xqo/sp/last-trade">
    <rdfs:comment xml:lang="en">Minimum price increment in points.</rdfs:comment>
    <rdfs:domain rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <rdfs:label xml:lang="en">last trade trade</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://schema.ga-group.nl/xqo/sp/specifiedBy">
    <rdfs:comment xml:lang="en">Links a futures contract to its contract specifications.</rdfs:comment>
    <rdfs:domain rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Future"/>
    <rdfs:label xml:lang="en">specified by</rdfs:label>
    <rdfs:range rdf:resource="http://schema.ga-group.nl/xqo/ps/ContractSpecs"/>
    <owl:inverseOf rdf:resource="http://purl.org/nemo/gufo#describes"/>
  </owl:ObjectProperty>
</rdf:RDF>
